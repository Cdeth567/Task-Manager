{
  "name": "candidate/task-manager-api",
  "description": "REST API task manager test assignment",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "doctrine/doctrine-bundle": "^2.12",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^3.0",
    "nelmio/api-doc-bundle": "^4.35",
    "symfony/console": "6.4.*",
    "symfony/dotenv": "6.4.*",
    "symfony/flex": "^2",
    "symfony/framework-bundle": "6.4.*",
    "symfony/http-foundation": "6.4.*",
    "symfony/routing": "6.4.*",
    "symfony/runtime": "6.4.*",
    "symfony/serializer": "6.4.*",
    "symfony/validator": "6.4.*",
    "symfony/twig-bundle": "6.4.*",
    "symfony/asset": "6.4.*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "symfony/phpunit-bridge": "^6.4",
    "symfony/browser-kit": "6.4.*",
    "symfony/css-selector": "6.4.*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpunit": "php bin/phpunit",
    "test": "php bin/phpunit",
    "lint": "find src tests bin public -name '*.php' -print0 | xargs -0 -n1 php -l",
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "6.4.*"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true,
      "symfony/flex": true
    }
  }
}
